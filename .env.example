# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# YouPI-PG — self-hosted UPI gateway, https://github.com/youpi-pg/YouPI-PG
# Payment API base URL (server-only), e.g. https://pay.example.com
YOUPI_API_URL=http://localhost:6100
# Checkout portal base URL — serves /youpi.js and the /checkout/:id iframe.
# Public because the browser loads the SDK from it. Defaults to YOUPI_API_URL.
NEXT_PUBLIC_YOUPI_PORTAL_URL=http://localhost:7000
# Merchant UUID from the gateway admin (optional if the gateway has one default merchant).
YOUPI_MERCHANT_ID=
# The merchant's webhook secret. Signs webhook deliveries to /api/webhooks/youpi
# and is sent as X-Merchant-Key so payment lookups return our metadata.
YOUPI_WEBHOOK_SECRET=

# Authorizes GET /api/keepalive, which pings Postgres so Supabase does not
# auto-pause the project. The route returns 401 when this is unset, so the
# scheduled ping needs the same value here and in the CI/host environment.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Vercel Cron also calls GET /api/cron/reconcile with this secret (vercel.json):
# it sweeps payment_orders for payments the gateway settled that never reached
# the purchases ledger, and re-applies featured flags a paid boost never set.

# Error tracking + paging for money incidents (lib/alert.ts, instrumentation.ts).
# Both optional; with neither set, incidents only reach the function logs.
# Sentry: create a Next.js project, paste its DSN, then add an alert rule on
# "event tag incident is set" (or per kind: duplicate_charge, entitlement_failed,
# payment_metadata_missing, reconcile_repaired, reconcile_failed).
SENTRY_DSN=
# Slack or Discord incoming-webhook URL for a direct ping on every incident.
ALERT_WEBHOOK_URL=

# Admin area (/admin): listing review queue, reports, refunds due, purchases.
# Comma-separated Clerk user ids. Users with {"role":"admin"} in their Clerk
# publicMetadata are admins too, so this is only needed to bootstrap.
ADMIN_USER_IDS=
# Or by email: comma-separated addresses. Only counts when that address is
# VERIFIED on the signed-in Clerk account, so it can bootstrap the first admin
# without opening the Clerk dashboard.
ADMIN_EMAILS=

# Transactional email via Resend (lib/email.ts): payment receipts, "a buyer
# unlocked your contact", listing approved/rejected. Unset = emails are logged
# and skipped. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="ArchIt <no-reply@example.com>"
# Optional: where replies to transactional emails go (e.g. the support inbox).
EMAIL_REPLY_TO=
# Base URL used for links in emails. Defaults to https://archit.chaudharyankit.in
NEXT_PUBLIC_SITE_URL=
# Product analytics (lib/analytics.ts): Vercel Web Analytics page views + the
# landing → sign-up → paid-unlock funnel events. Cookieless and first-party.
# Set to 1 on Vercel after enabling Web Analytics for the project; leave unset
# elsewhere and every analytics call is a no-op.
NEXT_PUBLIC_VERCEL_ANALYTICS=

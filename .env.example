# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# Set this to the signing secret configured on the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Authorizes GET /api/keepalive, which pings Postgres so Supabase does not
# auto-pause the project. The route returns 401 when this is unset, so the
# scheduled ping needs the same value here and in the CI/host environment.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
